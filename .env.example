# Google Cloud — OAuth 2.0 for the GOOGLE HEALTH API (health.googleapis.com)
# NOT the Google Fit API — that one is closed to new sign-ups and dies in 2026.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/callback
GOOGLE_PROJECT_ID=health-assistant-505718

# Restricted scopes — request only what the product reads.
GOOGLE_HEALTH_SCOPES=https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly

# Gemini API — https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database — Neon in production. Neon's dashboard gives you a plain
# postgresql:// URL; append ?sslmode=require (Neon requires TLS).
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/health_assistant?sslmode=require

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Cloud Scheduler -> POST /internal/run-daily auth (production only; see
# DEPLOY.md). RUN_DAILY_AUDIENCE is the deployed Cloud Run service URL;
# SCHEDULER_SERVICE_ACCOUNT_EMAIL is the service account the scheduler job
# runs as.
RUN_DAILY_AUDIENCE=https://health-assistant-xxxxx-uc.a.run.app
SCHEDULER_SERVICE_ACCOUNT_EMAIL=health-assistant-scheduler@your-project.iam.gserviceaccount.com

# Cloud Tasks fan-out (production only; see DEPLOY.md). /internal/run-daily
# enqueues one task per user instead of processing the batch inline.
# Leave TASKS_QUEUE unset locally — the endpoint then runs the batch inline
# so it still works end to end without a queue to talk to.
# TASKS_TARGET_BASE_URL defaults to RUN_DAILY_AUDIENCE, and
# TASKS_SERVICE_ACCOUNT_EMAIL defaults to SCHEDULER_SERVICE_ACCOUNT_EMAIL,
# so both can stay unset unless you deliberately split them.
TASKS_QUEUE=health-assistant-daily-queue
TASKS_LOCATION=us-central1
# TASKS_TARGET_BASE_URL=https://health-assistant-xxxxx-uc.a.run.app
# TASKS_SERVICE_ACCOUNT_EMAIL=health-assistant-tasks@your-project.iam.gserviceaccount.com
