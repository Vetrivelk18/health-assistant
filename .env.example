# Google Cloud - OAuth 2.0 (Google Health API)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback
GOOGLE_PROJECT_ID=health-assistant-505718
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Claude API (Anthropic)
CLAUDE_API_KEY=your_claude_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/health_assistant
# For local dev: postgresql://postgres:postgres@localhost:5432/health_assistant

# FastAPI
FASTAPI_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000
SECRET_KEY=your_secret_key_for_jwt_tokens_here

# Scheduler
SCHEDULER_HOUR=7  # Daily summary at 7 AM
SCHEDULER_MINUTE=0
TIMEZONE=Asia/Calcutta

# Google Health API
GOOGLE_HEALTH_SCOPES=https://www.googleapis.com/auth/fitness.sleep.read https://www.googleapis.com/auth/fitness.activity.read https://www.googleapis.com/auth/fitness.heart_rate.read

# MCP Server (for tool calling)
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000

# Logging
LOG_LEVEL=INFO
